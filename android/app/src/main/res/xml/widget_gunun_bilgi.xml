<?xml version="1.0" encoding="utf-8"?>
<!-- updatePeriodMillis yedek yenilemedir; asıl yenileme vakit geçişine kurulan alarmla yapılır. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_gunun_aciklama"
