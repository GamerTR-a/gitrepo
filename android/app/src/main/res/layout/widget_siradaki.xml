<?xml version="1.0" encoding="utf-8"?>
<!-- Küçük widget: sıradaki vakit. Tasarım: docs/tasarim/11_widget -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_kok"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_zemin"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/widget_konum"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#CFE0D8"
        android:textSize="12sp" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/widget_vakit_adi"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#E2C27A"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_saat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="serif"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="#FFFFFF"
        android:textSize="34sp" />

    <Chronometer
        android:id="@+id/widget_kalan"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#FFFFFF"
        android:textSize="13sp" />
</LinearLayout>
